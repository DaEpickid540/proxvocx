{
  "name": "proxvocx",
  "version": "2.20.1",
  "description": "Firebase-brokered PC connector: browse the web through your PC, or take it over outright. One desktop install, one hosted site, no Cloud Functions.",
  "type": "module",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "site": "npx --yes serve public",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "deploy": "firebase deploy --only hosting,database",
    "site:browse": "npx --yes serve -l 5001 public-browse"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "koffi": "^3.1.6"
  },
  "build": {
    "appId": "dev.proxvocx.connector",
    "productName": "proxvocx",
    "files": [
      "desktop/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icons/icon.ico",
      "uninstallerIcon": "public/icons/icon.ico",
      "installerHeaderIcon": "public/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icons/icon.png",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSCameraUsageDescription": "proxvocx does not use the camera.",
        "NSMicrophoneUsageDescription": "proxvocx does not use the microphone."
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icons/icon.png",
      "category": "Utility"
    }
  },
  "license": "AGPL-3.0-only",
  "private": true
}
