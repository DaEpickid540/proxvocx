# Path to the Firebase service account JSON downloaded from
# Project settings > Service accounts > Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Realtime Database URL, e.g. https://my-project-default-rtdb.firebaseio.com
# (europe/asia instances look like https://my-project-default-rtdb.europe-west1.firebasedatabase.app)
FIREBASE_DATABASE_URL=

# Optional: only serve this single uid. Leave empty to serve every uid that
# appears under /requests.
PROXY_USER_ID=

# Networking / safety limits
REQUEST_TIMEOUT_MS=20000
MAX_RESPONSE_BYTES=262144
MAX_REDIRECTS=5
MAX_CONCURRENT_REQUESTS=4

# Allow the proxy to reach private/loopback addresses (SSRF guard off).
# Keep false unless you really are proxying to your own LAN on purpose.
ALLOW_PRIVATE_NETWORK=false

# Requests older than this are dropped instead of fetched (ms).
REQUEST_MAX_AGE_MS=120000

# Responses are removed by the client after display; this is the server-side
# safety net (ms). Set to 0 to disable.
RESPONSE_TTL_MS=300000

# trace | debug | info | warn | error
LOG_LEVEL=info
